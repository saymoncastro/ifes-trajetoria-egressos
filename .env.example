# Procedimento completo do ambiente local: docs/desenvolvimento/ambiente-local.md
# Referência apenas: nada carrega este arquivo automaticamente.
# Exporte no shell as variáveis cujo padrão não servir (ver config/settings.py).
PGHOST=localhost
PGPORT=5432
PGUSER=trajetoria
PGPASSWORD=troque-esta-senha
PGDATABASE=trajetoria
DJANGO_SECRET_KEY=troque-esta-chave
# Feature 008 — "1" ativa a demonstração local com dados fictícios. Nunca em ambiente
# acessível a egressos nem sobre banco com dados reais. Desligado (padrão): toda página 404.
TRAJETORIA_DEMONSTRACAO=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Feature 016 — exclusivamente demonstração local, Mailpit loopback sem relay.
# Backend vazio mantém a operação desabilitada. Exporte explicitamente para demonstrar:
EMAIL_BACKEND=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
TRAJETORIA_URL_ENTRADA_DEMONSTRACAO=http://127.0.0.1:8000/acesso/

# 018: gerar cada chave separadamente com secrets.token_hex(32); nunca versionar valores.
TRAJETORIA_CHAVE_ACESSO_LOCALIZACAO=
TRAJETORIA_CHAVE_ACESSO_VERIFICACAO=
TRAJETORIA_SESSAO_INATIVIDADE=30
TRAJETORIA_SESSAO_DURACAO_MAXIMA=480
TRAJETORIA_COOKIE_SEGURO=

# Feature 019: duas chaves Fernet distintas, também distintas das chaves anteriores.
TRAJETORIA_CHAVE_SELO_DECLARACAO=
TRAJETORIA_CHAVE_CONSULTA_ACERVO=
# Validade dos selos de trânsito/início, em minutos (padrão: 30).
TRAJETORIA_SELO_DECLARACAO_VALIDADE=30

# Feature 013: chave dedicada da pseudonimização das exportações (secrets.token_hex(32)).
# Vazia, toda exportação é recusada. Distinta de todas as outras chaves.
TRAJETORIA_CHAVE_PSEUDONIMIZACAO=

# Feature 022 (opcional): renderizador de vídeo. Padrões: projeto `video/`, `node` do PATH,
# navegador provisionado em `video/`, 120 s por render, concorrência 2, retenção de
# 120 minutos (entre 1 e 1440; fora disso a aplicação não inicia).
# TRAJETORIA_VIDEO_PROJETO=
# TRAJETORIA_VIDEO_NODE=
# TRAJETORIA_VIDEO_NAVEGADOR=
# TRAJETORIA_VIDEO_TEMPO_MAXIMO=120
# TRAJETORIA_VIDEO_CONCORRENCIA=2
# TRAJETORIA_VIDEO_RETENCAO_MINUTOS=120

# Implantação em servidor: ver docs/implantacao/datacenter-ubuntu.md (seção 10).
