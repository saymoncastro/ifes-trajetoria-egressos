# Referência apenas: nada carrega este arquivo automaticamente.
# Exporte no shell as variáveis cujo padrão não servir (ver config/settings.py).
PGHOST=localhost
PGPORT=5432
PGUSER=trajetoria
PGPASSWORD=troque-esta-senha
PGDATABASE=trajetoria
DJANGO_SECRET_KEY=troque-esta-chave
# Feature 008 — "1" ativa a demonstração local com dados fictícios. Nunca em ambiente
# acessível a egressos nem sobre banco com dados reais. Desligado (padrão): toda página 404.
TRAJETORIA_DEMONSTRACAO=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Feature 016 — exclusivamente demonstração local, Mailpit loopback sem relay.
# Backend vazio mantém a operação desabilitada. Exporte explicitamente para demonstrar:
EMAIL_BACKEND=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
TRAJETORIA_URL_ENTRADA_DEMONSTRACAO=http://127.0.0.1:8000/demonstracao/
